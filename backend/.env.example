# NovaGuard Backend Environment Configuration Placeholder
# Application Settings
APP_NAME=NovaGuard API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Authentication Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard

# Local Edge AI Settings (Ollama offline runner)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma2:2b
LOCAL_LLM_ENABLED=True
